# Teaches: a basin needs BOTH currents. Routing only the short way along the row
# fills the basin and stops there; the anemone waits until the long way round over
# the top arrives too. The cheapest-looking route is the wrong plan.
id: 16
name: Two Streams
size: 6x4
par: 9
tide: 15
source: r2c0
grid:
  .. L3 I1 L1 .. ..
  .. I1 .. I1 .. ..
  e1 T1 I0 b0 I0 e3
  .. .. .. .. .. ..
critters:
  r2c5 anemone
solution:
  r0c1 cw1
  r0c1 cw1
  r0c3 cw1
  r1c1 cw1
  r1c3 cw1
  r2c1 cw1
  r2c1 cw1
  r2c2 cw1
  r2c4 cw1
