tide: 11
source: r3c0
grid:
  .. .. .. .. .. ..
  .. .. .. .. .. ..
  .. .. L3 T0 I0 e3
  e1 i1 L1 i0 .. ..
  .. .. .. .. .. ..
critters:
  r2c5 starfish
solution:
  r3c2 cw2
  r2c2 cw2
  r2c3 cw1
  r2c4 cw1
